#!/usr/bin/env bash
# Local safety gate before shipping. The "daily-lesson" App Hosting backend
# is GitHub-connected with automatic rollouts enabled (ABIU), so Firebase
# builds and deploys on its own whenever main is pushed — this script does
# NOT call `firebase deploy`. It just runs tests/lint/build locally so
# nothing broken gets pushed, then pushes.
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROJECT_ID="random-knowledge-ea232"
BACKEND_ID="${APPHOSTING_BACKEND:-daily-lesson}"
BRANCH="main"

cd "$REPO_ROOT"

current_branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$current_branch" != "$BRANCH" ]; then
  echo "Refusing to deploy from branch '$current_branch' — App Hosting tracks '$BRANCH'." >&2
  exit 1
fi

if [ -n "$(git status --porcelain)" ]; then
  echo "Working tree has uncommitted changes — commit or stash before deploying." >&2
  exit 1
fi

echo "==> Running tests"
npm --prefix apps/web run test

echo "==> Linting"
npm --prefix apps/web run lint

echo "==> Building"
npm --prefix apps/web run build

echo "==> Pushing '$BRANCH' (triggers an App Hosting rollout automatically)"
git push origin "$BRANCH"

echo "==> Pushed. Firebase App Hosting will build and deploy '$BACKEND_ID' automatically."
echo "    Track progress: firebase apphosting:rollouts:list $BACKEND_ID --project $PROJECT_ID"
