# Firebase web app config — from `firebase apps:sdkconfig WEB <APP_ID>` (setup-plan.md step 4).
# Safe to expose client-side by design.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Superadmin access is a Firebase Auth custom claim, not an env var — after
# deploying, bootstrap it by email:
#   npm run grant-superadmin -- you@example.com

# Server-side only — never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Firebase Admin service account JSON, as a single-line string, used by
# src/lib/firebase-admin.ts to verify ID tokens in /api/generate-lesson.
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
FIREBASE_SERVICE_ACCOUNT_KEY=
