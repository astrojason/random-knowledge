# Firebase web-SDK config — same project as apps/web, from
# `firebase apps:sdkconfig WEB <APP_ID>`. Safe to expose client-side by design.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Same server this app talks to for lesson generation (apps/web's
# /api/generate-lesson). Point this at wherever apps/web is deployed —
# e.g. its Vercel production URL — or http://localhost:3000 for local dev
# (use your machine's LAN IP instead of localhost when testing on a
# physical device, since the device can't reach your computer's loopback).
EXPO_PUBLIC_API_BASE_URL=
